#Carregamento dos dados----
library(tidyverse)
source("funcoes.R")
chutes_bundesliga <- read.csv("dados/chutes_bundesliga.csv")
#Seleção dos dados para o modelo----
bundesliga_preparados <- preparar_dados_xg(chutes_bundesliga)
features_df <- bundesliga_preparados %>% select(-is_goal)
labels_vector <- bundesliga_preparados$is_goal
features_matrix <- model.matrix(~ . -1, data = features_df)
##Dividir em treino e teste
set.seed(42)
train_indices <- sample(1:nrow(features_matrix), size = 0.8
train_indices <- sample(1:nrow(features_matrix), size = 0.8 * nrow(features_matrix))
train_indices <- sample(1:nrow(features_matrix), size = 0.8 * nrow(features_matrix))
train_data <- features_matrix[train_indices, ]
train_labels <- labels_vector[train_indices]
test_data <- features_matrix[-train_indices, ]
test_labels <- labels_vector[-train_indices]
##Construir o modelo
build_model <- function() {
model <- keras_model_sequential() %>%
layer_dense(units = 64, activation = "relu", input_shape = c(ncol(train_data))) %>%
layer_dense(units = 32, activation = "relu") %>%
layer_dense(units = 1, activation = "sigmoid")
model %>% compile(
loss = "binary_crossentropy",
optimizer = optimizer_rmsprop(),
metrics = c("accuracy")
)
return(model)
}
# Parâmetros da Validação Cruzada
k <- 4
num_epochs <- 100 # Você pode ajustar isso
# Seu loop de K-Fold
indices <- sample(1:nrow(train_data))
folds <- cut(indices, breaks = k, labels = FALSE)
all_acc_histories <- NULL
for (i in 1:k) {
cat("Processando fold #", i, "de", k, "\n")
val_indices <- which(folds == i, arr.ind = TRUE)
# Dados de validação e treino parcial para este fold
val_data <- train_data[val_indices, ]
val_labels <- train_labels[val_indices]
partial_train_data <- train_data[-val_indices, ]
partial_train_labels <- train_labels[-val_indices]
# Normalização (Standardization) DENTRO do loop
train_mean <- colMeans(partial_train_data)
train_std <- apply(partial_train_data, 2, sd)
partial_train_data <- scale(partial_train_data, center = train_mean, scale = train_std)
val_data <- scale(val_data, center = train_mean, scale = train_std)
# Treinamento
model <- build_model()
history <- model %>% fit(
partial_train_data, partial_train_labels,
validation_data = list(val_data, val_labels),
epochs = num_epochs, batch_size = 16, verbose = 0
)
# Armazenar histórico de acurácia na validação
acc_history <- history$metrics$val_accuracy
all_acc_histories <- rbind(all_acc_histories, acc_history)
}
# Calcular a melhor época com base na média da acurácia
average_acc_history <- apply(all_acc_histories, 2, mean, na.rm = TRUE)
best_epoch <- which.max(average_acc_history)
cat("\nNúmero ideal de épocas encontrado:", best_epoch, "\n")
# Treinar o modelo final com todos os dados de treino e o número ideal de épocas
model_final <- build_model()
# Normalizar os dados de treino e teste com base APENAS nos dados de treino
final_mean <- colMeans(train_data)
final_std <- apply(train_data, 2, sd)
train_data_scaled <- scale(train_data, center = final_mean, scale = final_std)
test_data_scaled <- scale(test_data, center = final_mean, scale = final_std) # Usa a mesma escala do treino
# Treino final
model_final %>% fit(
train_data_scaled, train_labels,
epochs = best_epoch, batch_size = 16, verbose = 0
)
# Avaliar o desempenho no conjunto de teste que o modelo nunca viu
results <- model_final %>% evaluate(test_data_scaled, test_labels)
cat("\nResultados no conjunto de teste final:\n")
print(results)
#Seleção de Features para usar no modelo final----
