# !! CORREÇÃO AQUI !! Usamos StatsBombR:: para especificar a função
# =================================================================
matches_da_liga <- StatsBombR::matches(
competition_id = comps_filtrado$competition_id[i],
season_id = comps_filtrado$season_id[i]
)
shots <- get.allevents(matches_da_liga) %>%
filter(type.name == "Shot")
if (nrow(shots) > 0) {
shots_por_liga[[comps_filtrado$competition_name[i]]] <- shots
}
}
shots_por_liga[[comps_big5_2016$competition_name[i]]] <- shots
# 6. Loop robusto para buscar os dados
for (i in 1:nrow(comps_big5_2016)) {
liga_atual <- comps_big5_2016$competition_name[i]
message("Iniciando busca para: ", liga_atual)
# Bloco 'try' para capturar possíveis erros sem parar o script
shots <- try({
matches_da_liga <- StatsBombR::matches(
competition_id = comps_big5_2016$competition_id[i],
season_id = comps_big5_2016$season_id[i]
)
get.allevents(matches_da_liga) %>%
filter(type.name == "Shot")
})
# Verificar se o 'try' NÃO resultou em erro E se o dataframe não está vazio
if (!inherits(shots, "try-error") && nrow(shots) > 0) {
message("✅ Sucesso! ", nrow(shots), " chutes encontrados para ", liga_atual)
shots_por_liga[[liga_atual]] <- shots
} else {
message("⚠️ Aviso: Nenhum chute encontrado ou erro ao processar dados para ", liga_atual)
}
}
