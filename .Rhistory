group_by(Liga) %>%
summarise(
Gols = sum(shot.outcome.name == "Goal", na.rm = TRUE),
Jogos = n_distinct(match_id),
GolsPorJogo = Gols / Jogos
) %>%
arrange(desc(GolsPorJogo))
ggplot(analise_gols_por_jogo, aes(x = reorder(Liga, -GolsPorJogo), y = GolsPorJogo)) +
